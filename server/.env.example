# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# NOTE 1: These are the environment variables for the backend application
# NOTE 2: You should have your own .env file which is a copy of the .env.example file
# NOTE 3: Always make sure to check if your .env file for server matches the .env.example file for server

# General configurations
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"
TEST_DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/test_mydb?schema=public"

# Hash Salt
HASH_SALT = 10

# TODO: Refresh tokens (http-only cookie, server)
# Eg: 60, "2 days", "10h", "7d". A numeric value is interpreted as a seconds count. 
# If you use a string be sure you provide the time units (days, hours, etc), 
# otherwise milliseconds unit is used by default ("120" is equal to "120ms"). 
JWT_REFRESH_SECRET="refresh"
JWT_REFRESH_EXPIRES_IN="7d"

# Access tokens (in-memory, client)
JWT_ACCESS_SECRET="access"
JWT_ACCESS_EXPIRES_IN="15m"

# ====== Only needed when using a Docker setup ======
# Docker Postgres Environment Variables
POSTGRES_USER=johndoe
POSTGRES_PASSWORD=randompassword
POSTGRES_DB=mydb



// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
    provider               = "prisma-client"
    output                 = "../../shared/prisma"
    previewFeatures        = ["typedSql"]
    generatedFileExtension = "ts"
    importFileExtension    = "ts"
    moduleFormat           = "esm"
}

generator zod {
    provider         = "prisma-zod-generator"
    output           = "../../shared/zod"
    prismaClientPath = "../../shared/prisma"
}

datasource db {
    provider = "postgresql"
}

enum PackageType {
    BASIC
    PRO
    ENTERPRISE
}

enum RoleType {
    SUPERADMIN
    HQADMIN
    BRANCHMANAGER
    CASHIER
}

enum PaymentMethodType {
    CASH
    ECASH
    CARD
}

enum TransactionStatusType {
    VOID
    COMPLETE
    REFUNDED
}

enum OfferStatusType {
    ENABLED
    DISABLED
    DRAFT
}

enum OfferType {
    OVERALL
    INDIVIDUAL
}

enum DiscountType {
    PERCENTAGE
    FIXEDVALUE
}

model User {
    id Int @id @default(autoincrement())

    /// @zod.string.min(1, { message: "Email cannot be empty" }).max(256)
    email String @unique @db.VarChar(256)

    /// @zod.string()
    password String @db.VarChar(256)

    /// @zod.string.min(1, { message: "First Name cannot be empty" }).max(256)
    firstName String @db.VarChar(256)

    /// @zod.string.min(1, { message: "Last Name cannot be empty" }).max(256)
    lastName String @db.VarChar(256)

    role RoleType @default(CASHIER)

    createdAt DateTime @default(now()) @db.Timestamptz(0)
    updatedAt DateTime @default(now()) @db.Timestamptz(0)
    fullName  String?  @default(dbgenerated()) @db.VarChar(256)

    resetToken          String?   @unique
    resetTokenExpiresAt DateTime?

    //One-to-many connections
    business   Business? @relation(fields: [businessId], references: [id])
    businessId Int?
    branch     Branch?   @relation(fields: [branchId], references: [id])
    branchId   Int?

    // Many-to-one connections
    transactions Transaction[]

    @@index([fullName])
    @@index([createdAt(sort: Desc)])
}

model Subscription {
    id               Int         @id @default(autoincrement())
    packageType      PackageType
    packageName      String
    numberBranches   Int
    baseCost         Float
    baseAccountLimit Int
    duration         Int

    // One-to-many connections
    businessSubscriptions BusinessSubscription[]
}

model BusinessSubscription {
    id                 Int      @id @default(autoincrement())
    dateApplied        DateTime
    additionalBranches Int
    totalCost          Float
    totalAccountLimit  Int

    // Many-to-one connections
    subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
    subscriptionId Int?
    business       Business?     @relation(fields: [businessId], references: [id])
    businessId     Int?
}

model Business {
    id       Int    @id @default(autoincrement())
    name     String @db.VarChar(256)
    location String @db.VarChar(256)

    // One-to-many connections
    businessSubscriptions BusinessSubscription[]
    branches              Branch[]
    products              Product[]
    users                 User[]
}

model Branch {
    id           Int    @id @default(autoincrement())
    location     String
    accountLimit Int

    // Many-to-one connections
    business   Business? @relation(fields: [businessId], references: [id])
    businessId Int?

    // One-to-many connections
    branchInventoryItems    BranchInventoryItem[]
    transactions            Transaction[]
    users                   User[]
    branchWideOfferBranches BranchWideOfferBranches[]
}

model BranchInventoryItem {
    id               Int @id @default(autoincrement())
    quantity         Int
    reorderThreshold Int

    // Many-to-one connections
    branch    Branch?  @relation(fields: [branchId], references: [id])
    branchId  Int?
    product   Product? @relation(fields: [productId], references: [id])
    productId Int?
}

model Transaction {
    id                Int                   @id @default(autoincrement())
    totalPrice        Float
    dateofTransaction DateTime
    paymentMethod     PaymentMethodType
    status            TransactionStatusType
    discount          Float

    // Many-to-one connections
    branch   Branch? @relation(fields: [branchId], references: [id])
    branchId Int?
    user     User?   @relation(fields: [userId], references: [id])
    userId   Int?

    // One-to-many connections
    transactionItems TransactionItem[]
}

model Product {
    id          Int    @id @default(autoincrement())
    productName String
    basePrice   Float
    shelfPrice  Float

    // Many-to-one connections
    business   Business? @relation(fields: [businessId], references: [id])
    businessId Int?
    supplier   Supplier? @relation(fields: [supplierId], references: [id])
    supplierId Int?

    // One-to-many connections
    branchInventoryItems    BranchInventoryItem[]
    productCategories       ProductCategory[]
    branchWideOfferProducts BranchWideOfferProduct[]
    transactionItems        TransactionItem[]

    @@index([businessId])
}

model TransactionItem {
    id           Int     @id @default(autoincrement())
    quantity     Int
    currentPrice Float
    isBundle     Boolean

    // Many-to-one connections
    transaction       Transaction?    @relation(fields: [transactionId], references: [id])
    transactionId     Int?
    branchWideOffer   BranchWideOffer @relation(fields: [branchWideOfferId], references: [id])
    branchWideOfferId Int
    product           Product         @relation(fields: [productId], references: [id])
    productId         Int
}

model Supplier {
    id            Int    @id @default(autoincrement())
    supplierName  String
    contactPerson String
    email         String @db.VarChar(256)
    contactNumber String @db.VarChar(11)
    address       String

    // Many-to-one connections
    products Product[]
}

model ProductCategory {
    // Many-to-one connections
    category   Category @relation(fields: [categoryId], references: [id])
    categoryId Int
    product    Product  @relation(fields: [productId], references: [id])
    productId  Int

    // Junction table (composite key)
    @@id([categoryId, productId])
}

model Category {
    id           Int    @id @default(autoincrement())
    categoryName String

    // One-to-many connectoins
    productCategories ProductCategory[]
}

model BranchWideOfferProduct {
    unitDiscountValue Float
    requiredQuantity  Int
    discountType      DiscountType

    // Many-to-one connections
    branchWideOffer   BranchWideOffer @relation(fields: [branchWideOfferId], references: [id])
    branchWideOfferId Int
    product           Product         @relation(fields: [productId], references: [id])
    productId         Int

    // Junction table (composite key)
    @@id([branchWideOfferId, productId])
}

model BranchWideOffer {
    id                   Int             @id @default(autoincrement())
    offerName            String
    description          String
    startDate            DateTime
    endDate              DateTime
    isExclusive          Boolean
    offerStatus          OfferStatusType
    offerType            OfferType
    discountType         DiscountType
    overallDiscountValue Float

    // One-to-many connections
    branchWideOfferBranches BranchWideOfferBranches[]
    transactionItems        TransactionItem[]
    branchWideOfferProducts BranchWideOfferProduct[]
}

model BranchWideOfferBranches {
    // Many-to-one connections
    branch            Branch          @relation(fields: [branchId], references: [id])
    branchId          Int
    branchWideOffer   BranchWideOffer @relation(fields: [branchWideOfferId], references: [id])
    branchWideOfferId Int

    // Junction table (composite key)
    @@id([branchId, branchWideOfferId])
}

{
    "compilerOptions": {
        "composite": true,
        "declaration": true,
        "declarationMap": true,
        "outDir": "./dist",
        "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
        "allowImportingTsExtensions": true,
        "emitDeclarationOnly": true
    },
    "include": ["**/*.ts"],
    "exclude": ["dist", "node_modules"]
}
